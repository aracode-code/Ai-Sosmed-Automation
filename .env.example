# Salinan contoh — jangan menaruh secret di sini (LLD Lampiran A, §13.1).
# Secret (API key, OAuth token) HANYA di Windows Credential Manager / DPAPI.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=4317
APP_TIMEZONE=Asia/Jakarta
DATABASE_PATH=./data/database/app.sqlite
LOG_LEVEL=info
JOB_MAX_ATTEMPTS=3
SCHEDULER_POLL_INTERVAL_MS=5000
FLOW_WORKER_CONCURRENCY=1
